<% content_for :title, "Check your email · NAM A2 WAM" %>
<section class="auth-card" aria-labelledby="auth-title">
  <p class="auth-kicker">NAM A2 WAM</p>
  <h1 id="auth-title">Check your email</h1>
  <p class="auth-help" role="status"><%= SignInsController::SENT_MESSAGE %></p>
  <% if flash[:alert] %><p class="auth-error" role="alert"><%= flash[:alert] %></p><% end %>
  <%= form_with url: sign_in_code_path, method: :post, class: "auth-form" do |form| %>
    <%= form.label :email, "Email" %>
    <%= form.email_field :email, value: @email, required: true, autocomplete: "email" %>
    <%= form.label :code, "6-digit code" %>
    <%= form.text_field :code, required: true, inputmode: "numeric", autocomplete: "one-time-code", pattern: "[0-9 ]{6,7}", maxlength: 7 %>
    <%= form.submit "Sign in" %>
  <% end %>
  <p><a href="<%= new_sign_in_path %>">Use another address</a></p>
</section>
