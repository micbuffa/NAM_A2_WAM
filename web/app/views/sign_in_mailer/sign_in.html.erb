<h1 style="font-size:20px;margin:0 0 16px">Sign in to NAM A2 WAM</h1>
<p><a href="<%= @url %>" style="display:inline-block;padding:10px 18px;border-radius:8px;background:#9f82ff;color:#0b0a10;font-weight:700;text-decoration:none">Sign in</a></p>
<p>Or type this code in the rack:</p>
<p style="font-size:28px;font-weight:700;letter-spacing:.3em;font-family:ui-monospace,Menlo,monospace"><%= @code %></p>
<p style="color:#666">The link and the code work once and expire in <%= @minutes %> minutes. If you did not ask to sign in, ignore this email.</p>
