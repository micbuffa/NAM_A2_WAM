<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>NAM A2 WAM Rack</title>
  <%# Generated from examples/wam/index.html by bin/rack-sync (lib/rack_view.rb); edit the source, not this file. %>
  <%= csrf_meta_tags %>
  <link rel="icon" href="./plugins/nam-wam/neuralwamp-logo.svg" type="image/svg+xml">
  <script type="application/json" id="currentUser"><%= json_escape(@current_user_payload.to_json).html_safe %></script>
  <link rel="stylesheet" href="./ui/tokens.css">
  <link rel="stylesheet" href="./ui/base.css">
  <link rel="stylesheet" href="./ui/components.css">
  <link rel="stylesheet" href="./host.css">
  <link rel="stylesheet" href="./fx-chain.css">
</head>
<body>
  <div class="host-shell">
    <header class="host-topbar">
      <div class="host-brand">
        <span class="host-brand-mark"><tl-icon name="guitar" size="22"></tl-icon></span>
        <div class="host-brand-text"><h1>NAM A2</h1><p>Neural amp &amp; cabinet rack</p></div>
      </div>
      <div class="host-topbar-actions">
        <tl-button id="tunerButton" class="host-tuner-button" icon="tuner" size="sm" title="Open tuner (T)" aria-haspopup="dialog" aria-keyshortcuts="T" disabled>Tuner<kbd class="host-kbd">T</kbd></tl-button>
        <tl-badge id="engineStatus" class="host-engine" dot role="status" tone="warning" data-state="starting">Starting audio engine…</tl-badge>
        <a class="host-lab-link" href="./fx-test/">WAM FX Registry Lab</a>
        <div class="host-account" id="accountPanel" hidden>
          <span class="host-divider"></span>
          <tl-button id="accountSignIn" icon="user" size="sm" aria-haspopup="dialog" title="Keep presets, favorites and preferences on every device">Sign in</tl-button>
          <button class="account-chip" id="accountChip" type="button" aria-haspopup="dialog" title="Account" hidden>
            <span class="account-avatar" id="accountAvatar" aria-hidden="true"></span>
            <span class="account-chip-text"><strong id="accountEmail"></strong><span class="account-sync"><i></i>Synced</span></span>
          </button>
        </div>
        <tl-icon-button id="settingsButton" icon="settings" aria-label="Settings" title="Settings" disabled></tl-icon-button>
      </div>
    </header>
    <aside class="host-sidebar" id="hostSidebar" aria-label="Host controls">
      <section class="host-card host-devices" aria-labelledby="devices-title">
        <h2 id="devices-title"><span class="host-dot violet"></span>Audio devices<tl-button class="host-heading-action" id="refreshDevices" size="sm" variant="ghost" title="Look for connected audio devices again">Refresh</tl-button></h2>
        <label>Input <tl-select icon="guitar"><select id="inputDevice" title="Input device"></select></tl-select></label>
        <label>Output <tl-select icon="headphones"><select id="outputDevice" title="Output device"><option value="">System default</option></select></tl-select></label>
        <tl-button class="host-secondary" id="authorizeOutput" block icon="headphones">Choose output</tl-button>
        <p class="host-help" id="outputSupport"></p>
        <tl-button class="host-secondary live-toggle" id="enableLive" block variant="primary" icon="guitar" aria-pressed="false" disabled>Enable live input</tl-button>
        <p class="host-help" id="inputChannelStatus">Enable live input to detect the available channels.</p>
        <tl-button class="host-secondary" id="recoverAudio" block variant="danger" icon="power" hidden>Recover audio</tl-button>
      </section>

      <section class="host-card" aria-labelledby="source-title">
        <h2 id="source-title"><span class="host-dot violet"></span>Audio source</h2>
        <label>Source <tl-select icon="audio"><select id="audioSource"><option>Live input</option></select></tl-select></label>
        <div class="embedded-player" id="playerPanel" hidden>
          <p class="embedded-player-title"><span class="host-dot amber"></span>Audio player</p>
          <div class="transport" role="group" aria-label="Audio transport">
            <button class="player-control" id="play" type="button" aria-label="Play">▶</button>
            <button class="player-control" id="pause" type="button" aria-label="Pause">Ⅱ</button>
            <button class="player-control" id="stop" type="button" aria-label="Stop">■</button>
            <label class="loop-control"><tl-checkbox variant="switch"><input class="player-control" id="loop" type="checkbox"></tl-checkbox> Loop</label>
          </div>
          <label class="host-range">Position
            <tl-slider><input class="player-control" id="seek" type="range" min="0" max="1" step="0.001" value="0"></tl-slider>
          </label>
          <audio id="player" preload="metadata"></audio>
        </div>
        <p class="host-help" id="discovery"></p>
      </section>

      <section class="host-card host-presets" id="presetsPanel" aria-labelledby="presets-title" hidden>
        <h2 id="presets-title"><span class="host-dot amber"></span>Presets<span class="host-count" id="presetCount"></span></h2>
        <tl-select class="preset-picker"><select id="presetSelect" aria-label="Preset"></select></tl-select>
        <p class="host-help" id="presetScope"></p>
        <tl-button class="host-secondary" id="presetNew" block icon="plus" aria-haspopup="dialog">New preset</tl-button>
        <p class="host-help" id="presetStatus" role="status" aria-live="polite"></p>
      </section>

      <details class="host-card host-advanced">
        <summary>Session & diagnostics</summary>
        <div class="host-session-actions">
          <tl-button id="saveState" size="sm">Save WAM state</tl-button>
          <tl-button id="restoreState" size="sm">Restore state</tl-button>
        </div>
        <span class="host-help" id="stateSize"></span>
        <details class="validation-panel">
          <summary>Automated test results</summary>
          <p class="host-help">Diagnostic report generated only when this page is opened with <code>?auto=1</code>.</p>
          <pre id="automatedResult"></pre>
        </details>
      </details>

    </aside>

    <main class="rack-stage">
      <header class="rack-header">
        <div class="rack-heading">
          <div class="preset-heading">
            <p class="rack-kicker">Current preset</p>
            <div class="preset-title-row"><h2 id="presetTitle">Untitled rack</h2><tl-icon-button id="presetRename" icon="edit" size="sm" variant="ghost" aria-label="Rename preset" title="Rename preset" hidden></tl-icon-button><tl-icon-button id="presetRevert" icon="undo" size="sm" variant="ghost" aria-label="Revert to saved preset" title="Reload the preset, discarding unsaved changes" hidden></tl-icon-button></div>
            <p class="preset-meta" id="presetMeta">Not saved as a preset</p>
          </div>
          <div class="rack-source-actions"><tl-button id="toggleSidebar" icon="panel" aria-label="Close audio source panel" aria-controls="hostSidebar" aria-expanded="true" title="Change audio source">Change audio source</tl-button></div>
        </div>
        <div class="rack-chains" id="chainToggleSlot"></div>
        <div class="preset-header-actions" id="presetHeaderActions" hidden>
          <tl-button id="presetDelete" icon="trash" disabled>Delete</tl-button>
          <tl-button id="presetSaveButton" variant="primary" icon="save">Save</tl-button>
        </div>
      </header>
      <div class="rack-canvas">
      <p class="fx-help">Drop on a card to swap · Drop on + to insert at that position · Alt + ← / → to move. All plugins can be removed and added with +.</p>
      <section class="fx-rack" aria-label="Processing chain A">
        <aside class="fx-endpoint" aria-label="Chain A input">
          <div class="fx-endpoint-head"><span aria-hidden="true">IN</span><strong>INPUT · A</strong></div>
          <div class="fx-endpoint-routing">
            <label class="fx-select-label" id="inputChannelRow" hidden><span>Input channel</span><tl-select size="sm"><select id="inputChannel" title="Input channel"><option value="0">Input 1</option></select></tl-select></label></div>
          <div class="fx-endpoint-controls">
            <div class="fx-meter-column">
              <tl-meter class="fx-level" id="chainInputMeter" orientation="vertical" role="meter" aria-label="Input level dBFS" aria-valuemin="-60" aria-valuemax="0" aria-valuenow="-60"></tl-meter>
              <output id="chainInputLevel">−∞ dBFS</output>
            </div>
            <div class="fx-gain-column">
              <tl-knob class="fx-gain" label="Gain"><input id="sourceTrim" aria-label="Input gain" type="range" min="-48" max="12" step="0.5" value="0"><output slot="value" id="sourceTrimValue">0.0 dB</output></tl-knob>
              <tl-button class="fx-gain-reset" id="chainInputReset" size="sm" variant="ghost" aria-label="Reset input gain">Reset</tl-button>
            </div>
          </div>
        </aside>
        <section class="fx-chain" id="fxChain" aria-label="Effects — drag to swap cards, or Alt + arrow keys"></section>
        <aside class="fx-endpoint fx-output-strip" aria-label="Chain A output">
          <div class="fx-endpoint-head"><span aria-hidden="true">OUT</span><strong>OUTPUT · A</strong></div>
          <div class="fx-endpoint-routing"></div>
          <div class="fx-endpoint-controls">
            <div class="fx-meter-column">
              <tl-meter class="fx-level" id="chainOutputMeter" orientation="vertical" role="meter" aria-label="Output level dBFS" aria-valuemin="-60" aria-valuemax="0" aria-valuenow="-60"></tl-meter>
              <output id="chainOutputLevel">−∞ dBFS</output>
              <tl-button class="fx-gain-reset" id="chainOutputReset" size="sm" variant="ghost" aria-label="Reset output gain">Reset</tl-button>
            </div>
            <tl-knob class="fx-gain" label="Volume"><input id="chainOutputGain" aria-label="Output gain" type="range" min="-48" max="12" step="0.5" value="0"><output slot="value" id="chainOutputGainValue">0.0 dB</output></tl-knob>
            <tl-knob class="fx-pan" label="Pan" size="sm" title="Pan L/R — double-click to center"><input id="chainOutputPan" type="range" min="-1" max="1" step="0.01" value="0" aria-label="Chain A pan"><output slot="value" id="chainOutputPanValue">C</output></tl-knob>
          </div>
        </aside>
      </section>
      </div>
    </main>
  </div>

  <script src="./config.js"></script>
  <script type="module" src="./ui/index.js"></script>
  <script type="module" src="./main.js"></script>
</body>
</html>
